{
  "name": "zotero-prism",
  "type": "module",
  "version": "1.0.0",
  "description": "Reading analytics, an AI copilot and full-text translation for Zotero. Free and open source — github.com/mxlapan/zotero-prism · 免费开源，发布和使用均不收取任何费用。",
  "config": {
    "addonName": "Zotero Prism",
    "addonID": "prism@zotero-prism.org",
    "addonRef": "prism",
    "addonInstance": "Prism",
    "prefsPrefix": "extensions.zotero.prism"
  },
  "author": "mxlapan",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/mxlapan/zotero-prism",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "start": "npm run vendor && zotero-plugin serve",
    "build": "npm run vendor && zotero-plugin build && tsc --noEmit",
    "build:fast": "npm run vendor && zotero-plugin build",
    "typecheck": "tsc --noEmit",
    "release": "zotero-plugin release",
    "test": "node test/run.mjs"
  },
  "dependencies": {
    "@vscode/markdown-it-katex": "^1.1.2",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.7",
    "markdown-it": "^15.0.2",
    "zotero-plugin-toolkit": "^5.2.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.10.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.9.2",
    "zotero-types": "^4.1.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mxlapan/zotero-prism.git"
  }
}
